# Copy to .env and fill in. Never commit real tokens or hosts.

# ---------------------------------------------------------------------------
# SSE collector -- compose profile "sse", service sse_collector
#
# SSE_ALLOWED_HOSTS is required and must contain the exact hostname of
# UPSTREAM_SSE_URL. The collector refuses to start without it.
# SSE_SOURCE_ID must equal the source_id the API assigned in the UI.
# ---------------------------------------------------------------------------
# UPSTREAM_SSE_URL=https://your-upstream.example.com/events
# SSE_ALLOWED_HOSTS=your-upstream.example.com
# SSE_SOURCE_ID=
# SSE_SOURCE_TYPE=application
# SSE_BEARER_TOKEN=
# SSE_ALLOW_INSECURE_HTTP=false
# SSE_CONNECT_TIMEOUT_SECONDS=10
# SSE_READ_TIMEOUT_SECONDS=60
# SSE_RECONNECT_INITIAL_SECONDS=1
# SSE_RECONNECT_MAX_SECONDS=30
# SSE_MAX_EVENT_BYTES=262144
# SSE_MAX_WIRE_BYTES=900000
# SSE_RETRY_MAX_SECONDS=300

# ---------------------------------------------------------------------------
# Simulated live stream (demo) -- compose profile "sim", service live_sim
#
# SIM_SOURCE_ID must equal the source_id the API assigned in the UI, or events
# normalize but land on a source that is not in the registry.
#
# SIM_FORMAT is DLQ-free by default: every generator in the default mix parses,
# so the whole stream reaches Silver. `unknown` is the free-form tier and is
# handled by drain3-fallback-v1. Add `malformed_json` only when you want
# deliberate DLQ traffic.
# ---------------------------------------------------------------------------
SIM_SOURCE_ID=
SIM_SOURCE_TYPE=application
SIM_RATE=0.5
SIM_FORMAT=syslog,cef,json,unknown
SIM_COLLECTOR_ID=live-sim-1
