# Oracle Always Free deployment environment.
#   docker compose --env-file deploy/oracle/env.oracle -f docker-compose.yml \
#     -f docker-compose.prod.yml -f docker-compose.oracle.yml up -d --build
#
# Only the settings that must differ from the defaults live here.

# --- where state lives -------------------------------------------------------
# Bind-mounted under the project directory on the boot volume. The boot volume
# is 47 GB of the 200 GB Always Free block allowance, so this is persistent
# across reboots, but it is also the volume you would lose if you rebuilt the
# instance. For anything you care about, attach a separate block volume and
# point ULPF_DATA_DIR at it.
ULPF_DATA_DIR=./data

# --- the only port the internet should reach ---------------------------------
# The UI. Express proxies /backend to the API, so this is the entire public
# surface for browsing.
UI_BIND_ADDR=0.0.0.0
UI_PORT=3000

# --- ingestion endpoints ----------------------------------------------------
# 0.0.0.0 makes syslog (1514/udp, 5151/tcp) and the JSON endpoint (8081) reach
# the internet. Both accept unauthenticated writes. Leave this at 127.0.0.1
# until you have a firewall rule or a token check in front of them, then flip
# it to 0.0.0.0.
INGEST_BIND_ADDR=127.0.0.1

# Browser-direct access to the API. Irrelevant while the UI is same-origin, but
# this is the value that silently breaks if anyone points a browser at :8000.
CORS_ORIGINS=http://localhost:3000

# --- memory budget for 2 OCPU / 12 GB ---------------------------------------
# Container limits total ~8.5 GB, leaving ~3.5 GB for the kernel, Docker, and
# SSH. Exceeding these is what turns a busy hour into an OOM kill.
ORACLE_OPENSEARCH_HEAP=2g
ORACLE_OPENSEARCH_MEM_LIMIT=3072m
ORACLE_REDPANDA_MEM=2G
ORACLE_REDPANDA_MEM_LIMIT=2560m
ORACLE_API_MEM_LIMIT=768m
ORACLE_ORCHESTRATOR_MEM_LIMIT=768m
ORACLE_FILE_COLLECTOR_MEM_LIMIT=512m
ORACLE_INGEST_MEM_LIMIT=512m
ORACLE_SYSLOG_MEM_LIMIT=256m
ORACLE_UI_MEM_LIMIT=512m
